<!DOCTYPE html>
<html>
<head>
    <title>View Tickets</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Help Desk Tickets</h2>
        <a href="/tickets/new" class="btn btn-success">Create New Ticket</a>
    </div>
    
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee Name</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Update Status</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            <% tickets.forEach(ticket => { %>
            <tr>
              <td><%= ticket._id %></td>
              <td><%= ticket.employeeName %></td>
              <td><%= ticket.title %></td>
              <td><%= ticket.priority %></td>
              <td><%= ticket.status %></td>
              <td>
                <form action="/tickets/<%= ticket._id %>/update" method="POST" class="d-flex">
                  <select name="status" class="form-select form-select-sm me-2">
                    <option <%= ticket.status === 'Open' ? 'selected' : '' %>>Open</option>
                    <option <%= ticket.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                    <option <%= ticket.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-primary">Update</button>
                </form>
              </td>
              <td>
                <form action="/tickets/<%= ticket._id %>/delete" method="POST">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>